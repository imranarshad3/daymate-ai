# ─────────────── Basics ───────────────
PORT=5000
# Long random string. If empty, one is generated and stored automatically.
JWT_SECRET=

# ─────────────── Database ───────────────
# Leave empty to use a local JSON file (server/data/db.json).
# For production use MongoDB (free: https://www.mongodb.com/atlas)
MONGODB_URI=
MONGODB_DB=daymate

# ─────────────── AI agent (FREE options) ───────────────
# Google Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# Which one to try first: gemini | groq | anthropic  (the other is used automatically as backup)
AI_PROVIDER=gemini
# Optional: force a model (otherwise the best available model is picked automatically)
GEMINI_MODEL=
GROQ_MODEL=

# Optional paid alternative: https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ─────────────── Telegram reminders + chat ───────────────
# 1) Telegram par @BotFather -> /newbot -> token yahan paste karein
TELEGRAM_BOT_TOKEN=

# ─────────────── WhatsApp (Twilio) ───────────────
# https://console.twilio.com -> Messaging -> Try WhatsApp (sandbox)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox number, e.g. +14155238886
TWILIO_WHATSAPP_FROM=

# ─────────────── Web Push (optional) ───────────────
# Generated automatically if empty. Set them in production so they never change.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
